  "db_name": "PostgreSQL",
  "query": "SELECT z.name AS zone, r.name, r.rtype, r.content, r.ttl, r.priority\n         FROM dns_zones z\n         JOIN domains d ON d.id = z.domain_id\n         JOIN dns_records r ON r.zone_id = z.id\n         WHERE d.tenant_id = $1\n         ORDER BY z.name, r.name, r.rtype, r.content",
