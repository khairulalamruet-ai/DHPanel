  "query": "SELECT s.id, s.tenant_id, t.node_id, t.uid, s.folder, s.quarantine, s.kind\n           FROM malware_scans s JOIN tenants t ON t.id = s.tenant_id\n           WHERE s.state = 'queued' AND t.status IN ('active', 'suspended')\n           ORDER BY s.requested_at LIMIT $1",
