  "query": "SELECT id, domain_id, name, status, last_error, updated_at::text AS \"version!\"\n           FROM dns_zones\n           WHERE status = 'pending'\n              OR (status = 'error' AND updated_at < now() - make_interval(secs => $1::int))\n           ORDER BY updated_at, id\n           LIMIT $2",
