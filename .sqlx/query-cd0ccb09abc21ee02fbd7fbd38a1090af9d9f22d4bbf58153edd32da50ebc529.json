  "query": "SELECT z.id, z.domain_id, z.name, z.status, z.last_error\n         FROM dns_zones z JOIN domains d ON d.id = z.domain_id\n         WHERE d.tenant_id = $1 AND $2 LIKE '%.' || z.name\n         ORDER BY length(z.name) DESC LIMIT 1",
