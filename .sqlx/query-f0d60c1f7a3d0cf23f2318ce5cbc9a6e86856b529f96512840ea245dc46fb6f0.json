  "query": "SELECT d.fqdn, c.chain_pem AS \"chain_pem!\"\n           FROM certificates c JOIN domains d ON d.id = c.domain_id\n           WHERE d.tenant_id = $1 AND c.kind = 'custom' AND c.chain_pem IS NOT NULL\n           ORDER BY d.fqdn\n           LIMIT 200",
