{
  "openapi": "3.1.0",
  "info": {
    "title": "DHPanel API",
    "description": "Control plane API for the DHPanel hosting panel. Errors use RFC 9457 Problem Details (`application/problem+json`).",
    "license": {
      "name": "Proprietary"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the panel"
    }
  ],
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session.",
        "operationId": "logout",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "The session's csrf_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out; cookie cleared"
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Missing or wrong X-CSRF-Token (code csrf_failed)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in account.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Current account and the session's CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "2FA state of the signed-in account.",
        "operationId": "getMfaStatus",
        "responses": {
          "200": {
            "description": "2FA state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStatus"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/totp/confirm": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Confirm TOTP enrolment with a code from the authenticator app. Enables\n2FA and returns the backup codes (shown only this once).",
        "operationId": "confirmTotp",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "The session's csrf_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "2FA enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupCodes"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_mfa_code`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "`mfa_not_pending`: no enrolment in progress",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/totp/disable": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Disable TOTP and delete all backup codes. Requires the current password.",
        "operationId": "disableTotp",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "The session's csrf_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "2FA disabled (also when it was not enabled)"
          },
          "403": {
            "description": "`password_incorrect` or `csrf_failed`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many wrong passwords",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/totp/enroll": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Start TOTP enrolment: returns a new secret to add to an authenticator app.\n2FA is not active until the secret is confirmed with a code.",
        "operationId": "enrollTotp",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "The session's csrf_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New secret; calling again before confirming replaces it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrollment"
                }
              }
            }
          },
          "403": {
            "description": "`password_incorrect` or `csrf_failed`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "`mfa_already_enabled`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many wrong passwords",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/public/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in with username or email and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; session cookie set",
            "headers": {
              "set-cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "__Host-dh_session=…; Path=/; Secure; HttpOnly; SameSite=Strict"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "202": {
            "description": "Password accepted but a second factor is required: a short-lived `__Host-dh_mfa` cookie is set; continue with POST /api/v1/public/auth/login/mfa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaChallenge"
                }
              }
            }
          },
          "401": {
            "description": "Invalid username or password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Correct password but account suspended or disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Malformed body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts for this account or address",
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Seconds until the lock expires"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/auth/login/mfa": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Second login step: verify a TOTP or backup code and start the session.",
        "operationId": "loginMfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; session cookie set, pending cookie cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_mfa_code`, or `mfa_session_expired` when the pending login is missing or older than 5 minutes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts",
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Seconds until the lock expires"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/health": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Liveness: the process answers HTTP",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/ready": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Readiness: all dependencies (database, redis, ...) are reachable",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "All checks passed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "503": {
            "description": "At least one check failed or timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BackupCodes": {
        "type": "object",
        "description": "Backup codes, shown exactly once.",
        "required": [
          "backup_codes"
        ],
        "properties": {
          "backup_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ten single-use codes; store them somewhere safe."
          }
        }
      },
      "CheckResult": {
        "type": "object",
        "description": "Public result for one probe.",
        "required": [
          "name",
          "status",
          "duration_ms"
        ],
        "properties": {
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Time taken, in milliseconds.",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Probe name, e.g. `database`."
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus",
            "description": "Outcome."
          }
        }
      },
      "CheckStatus": {
        "type": "string",
        "description": "Outcome of one probe.",
        "enum": [
          "ok",
          "failed",
          "timeout"
        ]
      },
      "CodeRequest": {
        "type": "object",
        "description": "A 6-digit authenticator code.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Code currently shown by the authenticator app.",
            "example": "123456"
          }
        },
        "additionalProperties": false
      },
      "FieldError": {
        "type": "object",
        "description": "One invalid input field (used with 422).",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine code, e.g. `required`, `too_long`, `invalid_format`."
          },
          "field": {
            "type": "string",
            "description": "JSON pointer-ish field path, e.g. `email` or `limits.max_domains`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message (English; the UI translates by `code`)."
          }
        }
      },
      "Liveness": {
        "type": "object",
        "description": "Body of `/health`.",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`.",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Build version."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Login request body.",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string",
            "description": "Username or email address.",
            "example": "khairul"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Password."
          }
        },
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "description": "The signed-in account and its session's CSRF token.",
        "required": [
          "id",
          "kind",
          "username",
          "email",
          "locale",
          "csrf_token",
          "mfa_enabled"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "description": "Send as `X-CSRF-Token` on POST/PUT/PATCH/DELETE. Keep in memory only."
          },
          "email": {
            "type": "string",
            "description": "Email."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Account id."
          },
          "kind": {
            "type": "string",
            "description": "`admin`, `reseller` or `client`.",
            "example": "admin"
          },
          "locale": {
            "type": "string",
            "description": "UI locale (`en` or `bn`)."
          },
          "mfa_enabled": {
            "type": "boolean",
            "description": "Whether two-factor authentication (TOTP) is enabled."
          },
          "username": {
            "type": "string",
            "description": "Username."
          }
        }
      },
      "MfaChallenge": {
        "type": "object",
        "description": "Body of the 202 answer to a password login when 2FA is enabled.",
        "required": [
          "mfa_required",
          "methods",
          "expires_in"
        ],
        "properties": {
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the pending login expires.",
            "minimum": 0
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Accepted second factors: `totp`, `backup_code`."
          },
          "mfa_required": {
            "type": "boolean",
            "description": "Always `true`."
          }
        }
      },
      "MfaLoginRequest": {
        "type": "object",
        "description": "Second login step.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A 6-digit authenticator code or a backup code.",
            "example": "123456"
          }
        },
        "additionalProperties": false
      },
      "MfaStatus": {
        "type": "object",
        "description": "2FA state of the signed-in account.",
        "required": [
          "totp_enabled",
          "backup_codes_remaining"
        ],
        "properties": {
          "backup_codes_remaining": {
            "type": "integer",
            "format": "int64",
            "description": "Backup codes not yet used."
          },
          "totp_enabled": {
            "type": "boolean",
            "description": "TOTP is enabled (enrolment confirmed)."
          }
        }
      },
      "PasswordRequest": {
        "type": "object",
        "description": "Current password, required for sensitive changes.",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password",
            "description": "Current password."
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Wire format (RFC 9457 + DHPanel extensions `code`, `correlation_id`, `errors`).",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code."
          },
          "correlation_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request correlation ID, when known."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "Field errors (422 only)."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the status."
          },
          "type": {
            "type": "string",
            "description": "Problem type URI."
          }
        }
      },
      "ReadinessReport": {
        "type": "object",
        "description": "Body of `/ready`.",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "description": "One entry per registered probe, sorted by name."
          },
          "status": {
            "type": "string",
            "description": "`ready` or `not_ready`.",
            "example": "ready"
          }
        }
      },
      "TotpEnrollment": {
        "type": "object",
        "description": "A new, not yet confirmed TOTP secret.",
        "required": [
          "secret",
          "otpauth_uri"
        ],
        "properties": {
          "otpauth_uri": {
            "type": "string",
            "description": "`otpauth://` URI; render it as a QR code for the authenticator app."
          },
          "secret": {
            "type": "string",
            "description": "Base32 secret for manual entry."
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-dh_session",
        "description": "HttpOnly session cookie set by POST /api/v1/public/auth/login"
      }
    }
  },
  "tags": [
    {
      "name": "public",
      "description": "Unauthenticated health endpoints"
    },
    {
      "name": "auth",
      "description": "Login, logout, the current account and two-factor authentication"
    }
  ]
}
