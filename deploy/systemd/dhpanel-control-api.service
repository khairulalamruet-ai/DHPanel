# The DHPanel control plane (T19.02). It never runs as root: it needs the network (its own
# port, PostgreSQL, Redis, the agent port), its configuration (read only) and a few folders it
# writes (uploaded dumps, the scratch folder of backups, its licensing identity). Anything that
# needs more is done by the node agent and the privileged helper on the nodes, not here.
#
#   systemd-analyze security --offline=true dhpanel-control-api.service   # exposure below 3
[Unit]
Description=DHPanel control plane
Documentation=https://docs.dhpanel.dev/control-plane
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=dhpanel
Group=dhpanel
ExecStart=/usr/local/bin/dhpanel-control-api
Environment=DHPANEL_CONFIG=/etc/dhpanel/control.toml
Restart=always
RestartSec=3
TimeoutStopSec=30
# One signal asks it to stop the API, the agent port and the dispatcher.
KillSignal=SIGTERM

# What it may write: /var/lib/dhpanel (uploads, scratch, the licensing identity). The
# configuration and the secrets in /etc/dhpanel are read only (ProtectSystem=strict; a
# ConfigurationDirectory= line would make that folder writable, which is why it is not used).
StateDirectory=dhpanel
StateDirectoryMode=0700
ReadWritePaths=/var/lib/dhpanel

# --- Hardening.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @debug @obsolete @cpu-emulation @clock
UMask=0077
# pg_dump (the system backup) is the one program it starts.
InaccessiblePaths=-/root -/boot

[Install]
WantedBy=multi-user.target
