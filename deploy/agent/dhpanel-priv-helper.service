# DHPanel privileged helper: the only part of the node side that runs as root.
# It listens on a Unix socket that only the dhpanel-agent user can open and
# carries out a short, fixed list of actions (see apps/priv-helper).
[Unit]
Description=DHPanel privileged helper
Documentation=https://docs.dhpanel.dev/agent
Before=dhpanel-agent.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/dhpanel-priv-helper --socket /run/dhpanel/priv-helper.sock --agent-user dhpanel-agent --tenants-root /srv/tenants
# The directory tenants live in is created by install.sh before the service is
# started: the sandbox's mount namespace is built before any ExecStartPre runs,
# so the path must already exist. It is the only place besides /run/dhpanel the
# helper may write.
ReadWritePaths=/srv/tenants
StateDirectory=dhpanel-priv-helper
StateDirectoryMode=0700
# /run/dhpanel, root-owned; other users can look inside but the socket is 0600.
RuntimeDirectory=dhpanel
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2

# --- Hardening. Root, but with almost nothing root can normally do. The
# --- capability list grows only together with the action that needs it.
NoNewPrivileges=yes
# CAP_CHOWN: hand the socket file and tenant directories to their owners.
# CAP_SYS_ADMIN: set project quota limits (quotactl); nothing else here needs it.
CapabilityBoundingSet=CAP_CHOWN CAP_SYS_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# xfs_quota passes the block device path of the mount to quotactl, so /dev must
# be the real one (PrivateDevices=yes hides it); DevicePolicy=closed still stops
# the helper from opening any device node.
PrivateDevices=no
DevicePolicy=closed
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=chown fchown fchownat quotactl quotactl_fd
UMask=0077

[Install]
WantedBy=multi-user.target
